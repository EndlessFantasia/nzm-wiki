{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "site",
  "description": "站点可读取桌面端状态、切换置顶和桌面端缓存、刷新缓存、打开独立计算器窗口、检查并安装桌面端更新、修改快捷键，并作为标题栏拖动和控制窗口；不要向站点开放文件、进程等敏感能力",
  "windows": ["main"],
  "remote": {
    "urls": ["https://nzm-wiki.com/*", "https://*.nzm-wiki.com/*", "http://localhost:3000/*"]
  },
  "permissions": [
    "allow-get-settings-state",
    "allow-set-pinned",
    "allow-set-desktop-cache",
    "allow-refresh-site-cache",
    "allow-open-calculator",
    "allow-get-calculator-visible",
    "allow-check-app-update",
    "allow-install-app-update",
    "allow-set-shortcut",
    "allow-reset-shortcuts",
    "allow-set-shortcuts-paused",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close"
  ]
}

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-origin-3010/
/.next-origin-3010-build/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# for qiekn
/refs
/refs-test
/kismet/
/log.txt
/MD
/scripts/kismet-bytecode

# generated indexes
/public/search-index.json
/public/weapon-stats.json
/public/sitemap.xml

# local generated artifacts
/.codex_tmp/
/tmp/
/.wrangler/

# Python bytecode caches
__pycache__/
*.py[cod]
